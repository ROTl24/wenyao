{
  "name": "liuyao-divination",
  "version": "0.5.4",
  "private": true,
  "author": "WenYao",
  "description": "本地优先的水墨六爻桌面与 PWA 应用",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "dev:web": "vite --host 0.0.0.0",
    "test": "npm run test:unit && npm run test:electron",
    "test:unit": "vitest run",
    "test:electron": "node --test electron/services/*.test.cjs",
    "test:watch": "vitest",
    "build:classics": "node scripts/build-classics.mjs",
    "build:corpus": "node scripts/build-corpus.mjs",
    "build:knowledge": "node scripts/build-knowledge.mjs",
    "eval:retrieval": "node scripts/evaluate-retrieval.cjs",
    "build:vectors": "node scripts/build-vectors.cjs",
    "verify:models": "node scripts/verify-stack.cjs",
    "verify:retrieval": "node scripts/verify-retrieval.cjs",
    "verify:analysis": "node scripts/verify-analysis.cjs",
    "typecheck": "tsc -b",
    "build:renderer": "tsc -b && vite build",
    "preview:web": "vite preview --host 0.0.0.0",
    "build": "npm run build:windows",
    "build:windows": "npm run build:renderer && node scripts/build-windows-installer.mjs --publish never",
    "build:macos": "npm run build:renderer && node scripts/build-macos.mjs",
    "release:windows": "npm run build:windows",
    "verify:release": "node scripts/verify-release.mjs",
    "verify:macos-release": "node scripts/verify-macos-release.mjs",
    "verify:web": "node scripts/verify-web-release.mjs",
    "start": "electron ."
  },
  "dependencies": {
    "@react-three/drei": "10.7.7",
    "@react-three/fiber": "9.6.1",
    "@react-three/postprocessing": "3.0.4",
    "@react-three/rapier": "2.2.0",
    "electron-updater": "6.8.9",
    "gsap": "3.15.0",
    "lucide-react": "1.24.0",
    "lunar-javascript": "1.7.7",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-gfm": "^3.1.0",
    "micromark-extension-gfm": "^3.0.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "three": "0.185.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.185.0",
    "@vitejs/plugin-react": "6.0.3",
    "concurrently": "10.0.5",
    "electron": "43.1.0",
    "electron-builder": "26.15.3",
    "jsdom": "29.1.1",
    "typescript": "7.0.2",
    "vite": "8.1.4",
    "vite-plugin-commonjs": "^0.10.4",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "4.1.10",
    "wait-on": "9.0.10"
  },
  "build": {
    "appId": "com.liuyao.divination",
    "productName": "问爻",
    "asar": true,
    "files": [
      "dist/**/*",
      "electron/**/*",
      "shared/**/*",
      "config/**/*",
      "resources/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "ROTl24",
        "repo": "wenyao",
        "channel": "latest",
        "releaseType": "draft"
      }
    ],
    "win": {
      "icon": "build/icon.png",
      "electronUpdaterCompatibility": ">=2.16",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "WenYao-${version}-Setup.${ext}"
    },
    "mac": {
      "icon": "build/icon.icns",
      "identity": "-",
      "hardenedRuntime": false,
      "minimumSystemVersion": "13.0",
      "category": "public.app-category.lifestyle",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "artifactName": "WenYao-${version}-universal.${ext}"
    },
    "dmg": {
      "title": "问爻 ${version}",
      "contents": [
        {
          "x": 140,
          "y": 220
        },
        {
          "x": 400,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "include": "build/installer.nsh",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "问爻"
    }
  }
}
